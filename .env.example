# ============================================================
# D&C Scale — Variables de entorno
# Copiar como .env y completar los valores reales
# NUNCA commitear el .env al repo
# ============================================================

# ── Claude API ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://XXXXXXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_KEY=eyJhbGci...      # Solo en backend/GitHub Actions, nunca en frontend

# ── Shopify (DMancuello) ────────────────────────────────────
SHOPIFY_STORE_DOMAIN=dmancuello.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...        # Shopify Admin API token
SHOPIFY_WEBHOOK_SECRET=...            # Generado al crear el webhook en Shopify
SHOPIFY_CLIENT_ID=dmancuello

# ── Meta Ads (DMancuello) ───────────────────────────────────
META_ACCESS_TOKEN=...                 # Token de larga duración de Meta Business
META_AD_ACCOUNT_ID=act_...            # ID de la cuenta publicitaria
META_CLIENT_ID=dmancuello
